#!/usr/bin/env node
/**
 * elonfeedback — local CLI for the human-feedback pages app.
 * Posts decision requests to the configured single-user instance and picks up its owner's answers.
 * Dependency-free (Node built-ins only). Matches CONTRACT.md in ~/work/elonfeedback.
 *
 * Commands:
 *   ask [file.json|-]                 post a decision request; prints the URL
 *   pending [--cwd D] [--project P]   list OPEN requests waiting on the owner
 *   inbox   [--cwd D] [--project P] [--since ISO] [--pick] [--json] [--quiet]
 *                                     show ANSWERED-but-unpicked requests + the owner's answers
 *   pickup  <slug> [<slug> ...]       mark answers picked up (stop re-surfacing)
 *   secret  <slug> <id> [--out FILE] [--print] [--keep-key]
 *                                     decrypt an E2E-encrypted secret LOCALLY
 *   get     <slug>                    show one request + its answers
 *   doctor                            print config + connectivity check
 */
'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');

const HOME = os.homedir();
const STATE_DIR = path.join(HOME, '.claude', 'elonfeedback');
const KEYS_DIR = path.join(STATE_DIR, 'keys');
const SECRETS_DIR = path.join(STATE_DIR, 'secrets');
const PROFILE_FILE = path.join(STATE_DIR, 'profile.json');          // APPROVED profile (never auto-written)
const PROFILE_PENDING = path.join(STATE_DIR, 'profile-pending.json'); // proposed next version, awaiting owner approval
const HKDF_INFO = Buffer.from('elonfeedback-secret-v1', 'utf8');

// ---------- config ----------
function parseDotEnv(keys) {
  const out = {};
  try {
    const txt = fs.readFileSync(path.join(HOME, '.env'), 'utf8');
    for (const raw of txt.split('\n')) {
      const line = raw.trim();
      if (!line || line.startsWith('#')) continue;
      const eq = line.indexOf('=');
      if (eq < 0) continue;
      const k = line.slice(0, eq).trim();
      if (keys.includes(k)) out[k] = line.slice(eq + 1).trim();
    }
  } catch (_) {}
  return out;
}
function cfg() {
  const need = ['ELONFEEDBACK_URL', 'ELONFEEDBACK_TOKEN'];
  const fromEnv = {};
  for (const k of need) if (process.env[k]) fromEnv[k] = process.env[k];
  const fromFile = parseDotEnv(need);
  const configuredUrl = fromEnv.ELONFEEDBACK_URL || fromFile.ELONFEEDBACK_URL || '';
  const token = fromEnv.ELONFEEDBACK_TOKEN || fromFile.ELONFEEDBACK_TOKEN || '';
  if (!configuredUrl) {
    fail('ELONFEEDBACK_URL 설정이 없습니다. `node scripts/setup.mjs`를 완료한 뒤 ~/.env에 ELONFEEDBACK_URL=https://내-배포주소 를 추가하세요.');
  }
  if (!token) {
    fail('ELONFEEDBACK_TOKEN 설정이 없습니다. `node scripts/setup.mjs`가 만든 토큰을 ~/.env 또는 환경 변수에 추가하세요.');
  }
  let parsed;
  try { parsed = new URL(configuredUrl); }
  catch (_) { fail('ELONFEEDBACK_URL이 올바른 URL이 아닙니다: ' + configuredUrl); }
  if (parsed.protocol !== 'https:' && parsed.protocol !== 'http:') {
    fail('ELONFEEDBACK_URL은 http:// 또는 https:// 주소여야 합니다.');
  }
  const url = configuredUrl.replace(/\/+$/, '');
  return { url, token };
}

// ---------- http ----------
async function api(method, pathname, { body, token, timeoutMs = 20000 } = {}) {
  const { url, token: cfgToken } = cfg();
  const bearer = token !== undefined ? token : cfgToken;
  const ac = new AbortController();
  const t = setTimeout(() => ac.abort(), timeoutMs);
  try {
    const res = await fetch(url + pathname, {
      method,
      headers: {
        'Content-Type': 'application/json',
        ...(bearer ? { Authorization: 'Bearer ' + bearer } : {}),
      },
      body: body !== undefined ? JSON.stringify(body) : undefined,
      signal: ac.signal,
    });
    const text = await res.text();
    let json;
    try { json = text ? JSON.parse(text) : {}; } catch (_) { json = { _raw: text }; }
    return { ok: res.ok, status: res.status, json };
  } finally {
    clearTimeout(t);
  }
}

// ---------- args ----------
function parseArgs(argv) {
  const flags = {}; const pos = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const key = a.slice(2);
      const next = argv[i + 1];
      if (next === undefined || next.startsWith('--')) { flags[key] = true; }
      else { flags[key] = next; i++; }
    } else pos.push(a);
  }
  return { flags, pos };
}
const norm = (p) => (p ? String(p).replace(/\/+$/, '') : p);

// ---------- key storage ----------
function ensureDirs() {
  fs.mkdirSync(KEYS_DIR, { recursive: true, mode: 0o700 });
  fs.mkdirSync(SECRETS_DIR, { recursive: true, mode: 0o700 });
  try { fs.chmodSync(STATE_DIR, 0o700); } catch (_) {}
}
const slugKey = (slug) => slug.replace(/[^\w.-]+/g, '__');
function saveKey(slug, privB64) {
  ensureDirs();
  const f = path.join(KEYS_DIR, slugKey(slug) + '.json');
  fs.writeFileSync(f, JSON.stringify({ slug, priv: privB64, createdAt: new Date().toISOString() }), { mode: 0o600 });
  try { fs.chmodSync(f, 0o600); } catch (_) {}
}
function loadKey(slug) {
  const f = path.join(KEYS_DIR, slugKey(slug) + '.json');
  if (!fs.existsSync(f)) return null;
  return JSON.parse(fs.readFileSync(f, 'utf8'));
}
function deleteKey(slug) {
  const f = path.join(KEYS_DIR, slugKey(slug) + '.json');
  try { fs.unlinkSync(f); }
  catch (e) { if (e && e.code === 'ENOENT') return true; return false; }
  return !fs.existsSync(f); // confirm it is actually gone
}

// strip terminal control chars from attacker-influenced fields before printing:
// answer text/transcript/attachment names flow into Claude, which auto-acts on them.
function safe(s, max = 2000) {
  if (s == null) return '';
  return String(s).replace(/[\x00-\x1f\x7f]/g, ' ').slice(0, max);
}

// ---------- commands ----------
async function cmdAsk(pos, flags = {}) {
  const src = pos[0] || '-';
  let raw;
  if (src === '-' || !src) raw = fs.readFileSync(0, 'utf8');
  else raw = fs.readFileSync(src, 'utf8');
  let payload;
  try { payload = JSON.parse(raw); }
  catch (e) { fail('요청 JSON 파싱 실패: ' + e.message); }

  if (!payload.project) fail('payload.project 필요');
  if (!payload.title) fail('payload.title 필요');
  if (!Array.isArray(payload.options) || payload.options.length < 1) fail('payload.options(1개 이상) 필요');
  if (!payload.cwd) payload.cwd = process.env.CLAUDE_PROJECT_DIR || process.cwd();
  if (!payload.machine) payload.machine = os.hostname();
  // Stamp the Claude Code session UUID so the answer can be routed back to THIS exact
  // session (the watcher fingerprints by slug-in-scrollback; sessionId + cwd are the
  // durable fallbacks so a dead/errored session's decisions are still findable later
  // by project via `inbox --cwd`). Overridable if the caller set it explicitly.
  if (!payload.sessionId && process.env.CLAUDE_CODE_SESSION_ID) {
    payload.sessionId = process.env.CLAUDE_CODE_SESSION_ID;
  }

  // If secrets requested, mint an ephemeral ECDH keypair; publish only the public key.
  let priv = null;
  if (Array.isArray(payload.secretRequests) && payload.secretRequests.length) {
    const ecdh = crypto.createECDH('prime256v1');
    ecdh.generateKeys();
    priv = ecdh.getPrivateKey().toString('base64');
    payload.recipientPubKey = ecdh.getPublicKey().toString('base64'); // 65-byte raw 0x04||X||Y
  }

  const { ok, status, json } = await api('POST', '/api/requests', { body: payload });
  if (!ok) fail(`요청 게시 실패 (HTTP ${status}): ${JSON.stringify(json)}`);
  if (priv) saveKey(json.slug, priv); // persist private key AFTER slug is known

  console.log('✅ 피드백 요청 게시됨');
  console.log('   URL : ' + json.url);
  console.log('   slug: ' + json.slug + (payload.secretRequests ? '   🔒(시크릿 요청 포함 — 로컬 개인키 저장됨)' : ''));

  if (flags.wait) {
    // Post-then-await: block-poll until the owner answers, then print it, so Claude can
    // continue in the SAME turn — like awaiting a subagent.
    console.log('\n결정권자에게 이 링크를 전하세요. 답을 기다립니다…');
    await cmdWait([json.slug], flags);
    return;
  }
  console.log('\n결정권자에게 이 링크를 열어 답해달라고 전하세요. 답은 나중에 `elonfeedback inbox`로 회수됩니다.');
}

async function fetchRequests(flags, status) {
  const q = new URLSearchParams();
  if (status) q.set('status', status);
  if (flags.project) q.set('project', flags.project);
  const { ok, status: st, json } = await api('GET', '/api/requests?' + q.toString());
  if (!ok) fail(`목록 조회 실패 (HTTP ${st}): ${JSON.stringify(json)}`);
  let reqs = json.requests || [];
  if (flags.cwd) { const c = norm(flags.cwd); reqs = reqs.filter((r) => norm(r.cwd) === c); }
  return reqs;
}

function ageOf(iso) {
  const then = Date.parse(iso);
  if (isNaN(then)) return '';
  const mins = Math.max(0, Math.round((Date.now() - then) / 60000));
  if (mins < 60) return mins + '분 전';
  const h = Math.round(mins / 60);
  if (h < 24) return h + '시간 전';
  return Math.round(h / 24) + '일 전';
}

async function cmdPending(flags) {
  const reqs = await fetchRequests(flags, 'open');
  if (flags.json) { console.log(JSON.stringify(reqs, null, 2)); return; }
  if (!reqs.length) { console.log('열린(미응답) 피드백 요청이 없습니다.'); return; }
  const { url } = cfg();
  console.log(`열린 피드백 요청 ${reqs.length}건:\n`);
  for (const r of reqs) {
    const dot = r.urgency === 'high' ? '🔴' : r.urgency === 'medium' ? '🟡' : '⚪';
    console.log(`${dot} [${r.project}] ${r.title}`);
    console.log(`   ${r.tldr}`);
    console.log(`   ${ageOf(r.createdAt)} · ${url}/${r.slug}\n`);
  }
}

async function fetchInbox(flags, timeoutMs) {
  const q = new URLSearchParams();
  if (flags.project) q.set('project', flags.project);
  if (flags.since) q.set('since', flags.since);
  q.set('unpickedOnly', '1');
  const { ok, status, json } = await api('GET', '/api/answers?' + q.toString(), timeoutMs ? { timeoutMs } : {});
  if (!ok) fail(`inbox 조회 실패 (HTTP ${status}): ${JSON.stringify(json)}`);
  let items = json.items || [];
  if (flags.cwd) { const c = norm(flags.cwd); items = items.filter((it) => norm(it.request.cwd) === c); }
  // keep only answers not yet picked up
  items = items
    .map((it) => ({ request: it.request, answers: (it.answers || []).filter((a) => !a.pickedUp) }))
    .filter((it) => it.answers.length);
  return items;
}

// Render one {request, answers[]} block — shared by inbox and wait.
function printItem(it, url) {
  const r = it.request;
  console.log(`━━━ [${r.project}] ${r.title}`);
  console.log(`    ${url}/${r.slug}`);
  for (const a of it.answers) {
    const opt = a.chosenOption ? (r.options.find((o) => o.n === a.chosenOption) || {}) : null;
    if (a.chosenOption) console.log(`    ▶ 선택: ${a.chosenOption}번${opt && opt.label ? ' — ' + opt.label : ''}`);
    const said = a.transcript || a.text;
    if (said) console.log(`    💬 "${safe(said)}"`);
    if (Array.isArray(a.attachments) && a.attachments.length) {
      for (const at of a.attachments) console.log(`    📎 ${safe(at.name, 200)} (${safe(at.contentType, 100)}) ${safe(at.url, 500)}`);
    }
    if (Array.isArray(a.secrets) && a.secrets.length) {
      for (const s of a.secrets) console.log(`    🔐 시크릿 '${safe(s.id, 100)}' 수신 — \`elonfeedback secret ${r.slug} ${safe(s.id, 100)}\` 로 로컬 복호화`);
    }
  }
  console.log('');
}

const sleep = (ms) => new Promise((res) => setTimeout(res, ms));

// Poll until the given slug has at least one answer, or timeout. Returns {request, answers} or null.
async function pollUntilAnswered(slug, { timeoutMs, intervalMs, onTick } = {}) {
  const deadline = Date.now() + (timeoutMs || 540000);
  let tick = 0;
  while (Date.now() < deadline) {
    try {
      const { ok, json } = await api('GET', '/api/answers?unpickedOnly=0', { timeoutMs: 12000 });
      if (ok) {
        const item = (json.items || []).find((it) => it.request.slug === slug);
        if (item && Array.isArray(item.answers) && item.answers.length) return item;
      }
    } catch (_) { /* transient: keep polling */ }
    if (onTick) onTick(++tick);
    await sleep(intervalMs || 8000);
  }
  return null;
}

// Wait (block-poll) for the owner to answer a specific decision, then print it — so Claude can
// post a decision and AWAIT the answer inline, like awaiting a subagent, and continue.
async function cmdWait(pos, flags) {
  const slug = pos[0];
  if (!slug) fail('사용법: elonfeedback wait <slug> [--timeout SEC] [--interval SEC]');
  const timeoutMs = Math.max(10, Number(flags.timeout) || 540) * 1000;
  const intervalMs = Math.max(3, Number(flags.interval) || 8) * 1000;
  const { url } = cfg();
  if (!flags.quiet) console.error(`⏳ ${slug} 답변 대기 중… (최대 ${Math.round(timeoutMs / 1000)}초, ${Math.round(intervalMs / 1000)}초 간격)`);
  const item = await pollUntilAnswered(slug, { timeoutMs, intervalMs });
  if (!item) {
    console.error(`⏳ 타임아웃 — 아직 답변이 없습니다. 나중에 \`elonfeedback wait ${slug}\`로 다시 대기하거나, 다음 세션에서 \`elonfeedback inbox\`로 픽업됩니다.`);
    process.exit(2); // exit 2 = timed out (not an error) so callers can re-wait or fall back to async
  }
  if (flags.json) { console.log(JSON.stringify(item, null, 2)); return; }
  console.log('✅ 답변 도착:\n');
  printItem(item, url);
}

async function cmdInbox(flags) {
  let items;
  try { items = await fetchInbox(flags, flags.quiet ? 5000 : undefined); }
  catch (e) { if (flags.quiet) process.exit(0); throw e; }

  if (flags.quiet) {
    if (items.length) {
      const n = items.reduce((s, it) => s + it.answers.length, 0);
      console.log(`📮 elonfeedback: 이 프로젝트에 응답된 피드백 ${n}건이 픽업 대기 중 — \`elonfeedback inbox --cwd .\`로 확인 후 반영하세요.`);
    }
    process.exit(0);
  }
  if (flags.json) { console.log(JSON.stringify(items, null, 2)); return; }
  if (!items.length) { console.log('픽업 대기 중인 답변이 없습니다.'); return; }

  const { url } = cfg();
  console.log(`픽업 대기 답변 ${items.length}건:\n`);
  for (const it of items) printItem(it, url);
  if (flags.pick) {
    const slugs = items.map((it) => it.request.slug);
    await api('POST', '/api/answers/pickup', { body: { slugs } });
    console.log(`(${slugs.length}건 픽업 완료로 표시)`);
  } else {
    console.log('반영을 끝냈으면 `elonfeedback pickup <slug>` 로 표시하면 다시 안 뜹니다.');
  }
}

async function cmdPickup(pos) {
  if (!pos.length) fail('사용법: elonfeedback pickup <slug> [<slug> ...]');
  const { ok, status, json } = await api('POST', '/api/answers/pickup', { body: { slugs: pos } });
  if (!ok) fail(`pickup 실패 (HTTP ${status}): ${JSON.stringify(json)}`);
  console.log(`픽업 완료: ${json.updated != null ? json.updated : pos.length}건`);
}

// Fetch ALL answered decisions (for history/profile). Optional cwd/project filter.
async function fetchHistory(flags) {
  const q = new URLSearchParams();
  if (flags.project) q.set('project', flags.project);
  q.set('unpickedOnly', '0');
  const { ok, status, json } = await api('GET', '/api/answers?' + q.toString());
  if (!ok) fail(`이력 조회 실패 (HTTP ${status}): ${JSON.stringify(json)}`);
  let items = json.items || [];
  if (flags.cwd) { const c = norm(flags.cwd); items = items.filter((it) => norm(it.request.cwd) === c); }
  // newest first by answeredAt (fallback createdAt)
  items.sort((a, b) => {
    const ta = Date.parse(a.request.answeredAt || a.request.createdAt) || 0;
    const tb = Date.parse(b.request.answeredAt || b.request.createdAt) || 0;
    return tb - ta;
  });
  return items;
}

// Distill each answered decision into the learning-relevant signal.
function distill(it) {
  const r = it.request;
  const a = (it.answers || []).slice(-1)[0] || {}; // latest answer wins
  const chosen = a.chosenOption ?? null;
  const opt = chosen ? (r.options || []).find((o) => o.n === chosen) : null;
  const recommended = (r.recommendation && r.recommendation.n) || (r.options || []).find((o) => o.recommended)?.n || null;
  return {
    date: r.date,
    project: r.project,
    slug: r.slug,
    title: r.title,
    chosenOption: chosen,
    chosenLabel: opt ? opt.label : null,
    recommendedOption: recommended,
    followedRecommendation: recommended != null && chosen != null ? chosen === recommended : null,
    comment: a.transcript || a.text || null,
    kind: a.kind || null,
  };
}

async function cmdHistory(flags) {
  const items = await fetchHistory(flags);
  const rows = items.map(distill);
  const k = Math.max(1, Number(flags.k) || 25);
  const top = rows.slice(0, k);

  if (flags.json) { console.log(JSON.stringify({ decisions: top, stats: historyStats(rows) }, null, 2)); return; }

  const scope = flags.project ? `프로젝트 '${flags.project}'` : flags.cwd ? `이 프로젝트(${flags.cwd})` : '전체';
  if (!rows.length) { console.log(`${scope}의 과거 결정 이력이 아직 없습니다.`); return; }
  const st = historyStats(rows);
  console.log(`${scope} 과거 결정 ${rows.length}건 (최신 ${top.length}건 표시)`);
  console.log(`추천 수용률: ${st.followRatePct}% (${st.followed}/${st.withRecommendation}건에서 클로드 추천을 따름)\n`);
  for (const d of top) {
    const mark = d.followedRecommendation === true ? '✓ 추천대로' : d.followedRecommendation === false ? '✗ 추천과 다르게' : '';
    console.log(`• [${d.date}] ${d.project} — ${safe(d.title, 60)}`);
    console.log(`   고른 답: ${d.chosenOption != null ? d.chosenOption + '번' + (d.chosenLabel ? ' ' + safe(d.chosenLabel, 40) : '') : '(번호 불명확)'} ${mark}`);
    if (d.comment) console.log(`   사용자 코멘트: "${safe(d.comment, 140)}"`);
  }
  console.log('\n이 이력을 새 결정 카드의 추천·선택지에 반영하세요(사용자의 과거 성향 참고).');
}

function historyStats(rows) {
  const withRec = rows.filter((d) => d.followedRecommendation !== null);
  const followed = withRec.filter((d) => d.followedRecommendation === true).length;
  return {
    total: rows.length,
    withRecommendation: withRec.length,
    followed,
    followRatePct: withRec.length ? Math.round((followed / withRec.length) * 100) : null,
  };
}

// ---------- decision-taste profile (learned, but NEVER applied without owner approval) ----------
function readProfile(file) {
  try { return JSON.parse(fs.readFileSync(file, 'utf8')); } catch (_) { return null; }
}

// `profile`                    show the approved profile
// `profile propose <file|->`   stage a draft + publish an APPROVAL decision page (does NOT apply)
// `profile apply`              promote the pending draft to approved (call ONLY after the owner approves)
// `profile reject`            discard the pending draft
// `profile pending`           show the staged draft
async function cmdProfile(pos, flags) {
  const sub = pos[0] || 'show';

  if (sub === 'show') {
    const p = readProfile(PROFILE_FILE);
    if (!p) { console.log('아직 승인된 성향 프로필이 없습니다. `elonfeedback history`로 이력을 보고 초안을 `profile propose`로 올리세요.'); return; }
    if (flags.json) { console.log(JSON.stringify(p, null, 2)); return; }
    console.log(`사용자 성향 프로필 v${p.version || 1} (승인 ${p.approvedAt || '?'})\n`);
    console.log(JSON.stringify(p.profile ?? p, null, 2));
    return;
  }

  if (sub === 'pending') {
    const p = readProfile(PROFILE_PENDING);
    if (!p) { console.log('대기 중인 프로필 제안이 없습니다.'); return; }
    console.log(JSON.stringify(p, null, 2));
    return;
  }

  if (sub === 'propose') {
    const src = pos[1] || '-';
    let raw;
    try { raw = (src === '-' ) ? fs.readFileSync(0, 'utf8') : fs.readFileSync(src, 'utf8'); }
    catch (e) { fail('초안 읽기 실패: ' + e.message); }
    let draft;
    try { draft = JSON.parse(raw); } catch (e) { fail('초안 JSON 파싱 실패: ' + e.message); }
    if (!draft.profile) fail('초안에 profile 객체가 필요합니다 ({ profile:{...}, changeSummary, rationale }).');

    const current = readProfile(PROFILE_FILE);
    const nextVersion = (current?.version || 0) + 1;
    ensureDirs();
    fs.writeFileSync(PROFILE_PENDING, JSON.stringify({
      version: nextVersion,
      proposedAt: new Date().toISOString(),
      profile: draft.profile,
      changeSummary: draft.changeSummary || '',
      rationale: draft.rationale || '',
    }, null, 2), { mode: 0o600 });

    // Publish an APPROVAL decision page. Applying is gated on the owner's answer (option 1).
    const summary = draft.changeSummary || '클로드가 파악한 사용자의 결정 성향을 이렇게 업데이트하려 합니다.';
    const currentText = current ? '```json\n' + JSON.stringify(current.profile ?? current, null, 2).slice(0, 1200) + '\n```' : '_아직 승인된 프로필 없음 (이게 첫 버전)_';
    const proposedText = '```json\n' + JSON.stringify(draft.profile, null, 2).slice(0, 1600) + '\n```';
    const payload = {
      project: flags.project || 'elon-profile',
      cwd: flags.cwd || process.env.CLAUDE_PROJECT_DIR || process.cwd(),
      machine: os.hostname(),
      urgency: 'low',
      title: `내 성향 프로필 업데이트 승인 (v${nextVersion})`,
      tldr: safe(summary, 120),
      whyNow: '이 프로필을 켜면 앞으로 모든 결정 카드가 내 성향에 맞춰집니다. 반영 전에 꼭 승인/의견을 받으려고요.',
      context: `**이번에 바뀌는 점**\n\n${summary}\n\n**지금 프로필**\n\n${currentText}\n\n**제안 프로필**\n\n${proposedText}\n\n${draft.rationale ? '**근거**: ' + draft.rationale : ''}`,
      stakes: '승인하면 결정 도우미가 나처럼 판단하기 시작합니다 🎯 (언제든 다시 바꿀 수 있어요)',
      options: [
        { n: 1, label: '승인하고 반영', whatChanges: '이 프로필을 켜서 앞으로 결정 카드에 반영', upside: '🎯 결정 카드가 내 취향대로', downside: '없음 — 언제든 재수정', effort: '낮음', reversible: true, recommended: true },
        { n: 2, label: '수정할게 (음성으로 말해줘)', whatChanges: '내 의견대로 프로필을 고쳐 다시 제안', upside: '✍️ 내 말이 반영됨', downside: '한 번 더 왕복', effort: '낮음', reversible: true, recommended: false },
        { n: 3, label: '그대로 둬 (반영 안 함)', whatChanges: '제안 폐기, 프로필 변경 없음', upside: '현상 유지', downside: '없음', effort: '낮음', reversible: true, recommended: false },
      ],
      recommendation: { n: 1, why: '틀린 부분이 있으면 2번으로 음성 의견 주시면 바로 고칩니다. 완벽하게 정하고 켤 필요 없어요.' },
      ifIgnored: '답 안 하시면 프로필은 지금 상태 그대로 유지됩니다(자동 반영 없음).',
      allowFreeform: true,
    };
    if (!payload.sessionId && process.env.CLAUDE_CODE_SESSION_ID) payload.sessionId = process.env.CLAUDE_CODE_SESSION_ID;

    const { ok, status, json } = await api('POST', '/api/requests', { body: payload });
    if (!ok) fail(`프로필 승인 페이지 게시 실패 (HTTP ${status}): ${JSON.stringify(json)}`);
    console.log('✅ 프로필 업데이트 승인 페이지 게시됨 (아직 반영 안 함 — 사용자 승인 대기)');
    console.log('   URL : ' + json.url);
    console.log('   pending 저장됨: ' + PROFILE_PENDING);
    console.log('\n사용자가 1번(승인)으로 답하면 `elonfeedback profile apply`, 2번(수정의견)이면 의견 반영해 다시 propose, 3번이면 `profile reject`.');
    return;
  }

  if (sub === 'apply') {
    const pending = readProfile(PROFILE_PENDING);
    if (!pending) fail('반영할 대기 프로필이 없습니다. 먼저 `profile propose`.');
    ensureDirs();
    const approved = { ...pending, approvedAt: new Date().toISOString(), approvedBy: 'owner' };
    fs.writeFileSync(PROFILE_FILE, JSON.stringify(approved, null, 2), { mode: 0o600 });
    try { fs.unlinkSync(PROFILE_PENDING); } catch (_) {}
    console.log(`✅ 성향 프로필 v${approved.version} 반영됨 → ${PROFILE_FILE}`);
    console.log('   ⚠️ 사용자가 실제로 승인(1번)했는지 inbox로 확인한 뒤에만 이 명령을 쓰세요.');
    return;
  }

  if (sub === 'reject') {
    try { fs.unlinkSync(PROFILE_PENDING); console.log('대기 프로필 제안을 폐기했습니다.'); }
    catch (_) { console.log('폐기할 대기 제안이 없습니다.'); }
    return;
  }

  fail('사용법: elonfeedback profile [show|pending|propose <file|->|apply|reject]');
}

async function cmdGet(pos) {
  const slug = pos[0];
  if (!slug) fail('사용법: elonfeedback get <slug>');
  const items = await fetchInbox({}); // all answered
  const found = items.find((it) => it.request.slug === slug);
  if (!found) {
    const open = await fetchRequests({}, undefined);
    const r = open.find((x) => x.slug === slug);
    if (r) { console.log(JSON.stringify({ request: r, answers: [] }, null, 2)); return; }
    fail('해당 slug를 찾을 수 없습니다: ' + slug);
  }
  console.log(JSON.stringify(found, null, 2));
}

async function cmdSecret(pos, flags) {
  const [slug, id] = pos;
  if (!slug || !id) fail('사용법: elonfeedback secret <slug> <id> [--out FILE] [--print] [--keep-key]');
  const key = loadKey(slug);
  if (!key) fail(`이 slug의 로컬 개인키가 없습니다 (${slug}). 이 요청이 이 머신에서 secretRequests 포함으로 생성됐나요?`);

  // find the encrypted secret in the answers for this slug
  const q = new URLSearchParams(); q.set('unpickedOnly', '0');
  const { ok, status, json } = await api('GET', '/api/answers?' + q.toString());
  if (!ok) fail(`답변 조회 실패 (HTTP ${status})`);
  const item = (json.items || []).find((it) => it.request.slug === slug);
  if (!item) fail('해당 slug의 답변이 아직 없습니다.');
  let enc = null;
  for (const a of item.answers) {
    const s = (a.secrets || []).find((x) => x.id === id);
    if (s) enc = s; // last one wins
  }
  if (!enc) fail(`답변에 시크릿 '${id}' 가 없습니다.`);

  // decrypt (ECDH P-256 -> HKDF-SHA256 -> AES-256-GCM), matching the browser encryptSecret
  let plaintext;
  try {
    const ecdh = crypto.createECDH('prime256v1');
    ecdh.setPrivateKey(Buffer.from(key.priv, 'base64'));
    const shared = ecdh.computeSecret(Buffer.from(enc.ephemeralPubKey, 'base64'));
    const aesKey = Buffer.from(crypto.hkdfSync('sha256', shared, Buffer.alloc(0), HKDF_INFO, 32));
    const buf = Buffer.from(enc.ciphertext, 'base64');
    const ct = buf.subarray(0, -16);
    const tag = buf.subarray(-16);
    const decipher = crypto.createDecipheriv('aes-256-gcm', aesKey, Buffer.from(enc.iv, 'base64'));
    // Reconstruct AAD from TRUSTED local values (slug/id), never from the ciphertext container.
    // A misfiled/tampered secret then fails GCM auth instead of silently decrypting.
    decipher.setAAD(Buffer.from(`${slug}:${id}`, 'utf8'));
    decipher.setAuthTag(tag);
    plaintext = Buffer.concat([decipher.update(ct), decipher.final()]).toString('utf8');
  } catch (e) {
    fail('복호화 실패: ' + e.message);
  }

  if (flags.print) {
    process.stdout.write(plaintext);
    if (process.stdout.isTTY) process.stdout.write('\n');
  } else {
    ensureDirs();
    const out = flags.out || path.join(SECRETS_DIR, slugKey(slug) + '-' + id + '.txt');
    fs.writeFileSync(out, plaintext, { mode: 0o600 });
    try { fs.chmodSync(out, 0o600); } catch (_) {}
    const mask = plaintext.length <= 8 ? '••••' : plaintext.slice(0, 3) + '…' + plaintext.slice(-3) + ` (len ${plaintext.length})`;
    console.log(`🔓 시크릿 '${id}' 복호화 완료 → ${out} (chmod 600)`);
    console.log(`   미리보기(마스킹): ${mask}`);
  }
  if (!flags['keep-key']) {
    const gone = deleteKey(slug);
    if (!flags.print) {
      if (gone) console.log('   개인키 삭제됨 — Blob의 암호문은 이제 영구 복호화 불가(전방 안전성).');
      else console.error('   ⚠️ 경고: 개인키 파일 삭제 실패. 전방 안전성 미보장 — 수동 삭제 필요: ' + path.join(KEYS_DIR, slugKey(slug) + '.json'));
    }
  }
}

async function cmdDoctor() {
  const { url, token } = cfg();
  console.log('elonfeedback doctor');
  console.log('  URL   : ' + url);
  console.log('  TOKEN : ' + (token ? 'set (len ' + token.length + ')' : '❌ 없음 — ~/.env의 ELONFEEDBACK_TOKEN 확인'));
  console.log('  keys  : ' + KEYS_DIR);
  try {
    const { ok, status } = await api('GET', '/api/requests?status=open', { timeoutMs: 8000 });
    console.log('  conn  : ' + (ok ? 'OK (HTTP ' + status + ')' : '실패 (HTTP ' + status + ')'));
  } catch (e) {
    console.log('  conn  : 실패 — ' + e.message);
  }
}

function fail(msg) { console.error('elonfeedback: ' + msg); process.exit(1); }

function usage() {
  console.log(`elonfeedback — 휴먼 피드백 페이지 CLI

  ask [file.json|-] [--wait] [--timeout SEC] [--interval SEC]
                                     결정 요청 게시(도파민 페이지). URL 출력.
                                     --wait: 답이 올 때까지 대기 후 답변 출력(서브에이전트처럼 이어가기).
  wait    <slug> [--timeout SEC] [--interval SEC] [--json]
                                     특정 결정의 답을 블록-폴링으로 대기(기본 540초). 답 오면 출력, 없으면 exit 2.
  pending [--cwd D] [--project P]     사용자 응답 대기 중인 열린 요청 목록
  inbox   [--cwd D] [--project P] [--since ISO] [--pick] [--json] [--quiet]
                                     응답 왔지만 미픽업인 답변 표시
  pickup  <slug> [<slug> ...]        답변 픽업 완료 표시(재노출 방지)
  history [--project P] [--cwd D] [--k N] [--json]
                                     과거 결정·추천 수용률(사용자 성향) 참고 — 새 카드 만들기 전 조회
  profile [show|pending|propose <file|->|apply|reject]
                                     사용자 성향 프로필. propose=초안→승인페이지 게시(반영 안 함),
                                     apply=사용자 승인 후에만 반영. 자동 반영 절대 금지.
  secret  <slug> <id> [--out F] [--print] [--keep-key]
                                     E2E 암호화 시크릿을 로컬에서만 복호화
  get     <slug>                     요청+답변 1건 JSON
  doctor                             설정/연결 점검`);
}

(async function main() {
  const [, , cmd, ...rest] = process.argv;
  const { flags, pos } = parseArgs(rest);
  try {
    switch (cmd) {
      case 'ask': await cmdAsk(pos, flags); break;
      case 'wait': await cmdWait(pos, flags); break;
      case 'pending': await cmdPending(flags); break;
      case 'inbox': await cmdInbox(flags); break;
      case 'pickup': await cmdPickup(pos); break;
      case 'history': await cmdHistory(flags); break;
      case 'profile': await cmdProfile(pos, flags); break;
      case 'secret': await cmdSecret(pos, flags); break;
      case 'get': await cmdGet(pos); break;
      case 'doctor': await cmdDoctor(); break;
      case undefined: case '-h': case '--help': case 'help': usage(); break;
      default: fail('알 수 없는 명령: ' + cmd + ' (elonfeedback help)');
    }
  } catch (e) {
    if (flags.quiet) process.exit(0);
    fail(e && e.message ? e.message : String(e));
  }
})();
